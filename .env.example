# =============================================================================
# OmniVoice API — Variables de entorno
# =============================================================================
# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# Los tipos y valores por defecto están definidos en `omnivoice_api/settings.py`.
#
# Para ejemplos específicos de plataforma, consulta:
#   - env.example.windows (Windows)
#   - env.example.linux   (Linux)
# =============================================================================


# ============================================================================
# VARIABLES OBLIGATORIAS
# (Debes configurar estas variables; no tienen valor por defecto útil)
# ============================================================================

# -----------------------------------------------------------------------------
# OmniVoice Engine (Obligatorio)
# -----------------------------------------------------------------------------

# Ruta al directorio de la instalación externa de OmniVoice
# Linux ejemplo: /opt/omnivoice
# Windows ejemplo: C:/tools/omnivoice
OMNIVOICE_INSTALL_DIR=

# Ruta al venv externo que contiene OmniVoice + CUDA
# Linux ejemplo: /opt/omnivoice/.venv
# Windows ejemplo: C:/tools/omnivoice/.venv
OMNIVOICE_VENV_DIR=

# Ruta al modelo de OmniVoice
# Si se deja vacío, se deriva como: ${OMNIVOICE_INSTALL_DIR}/models
# Linux ejemplo: /opt/omnivoice/models
# Windows ejemplo: C:/tools/omnivoice/models
OMNIVOICE_MODEL_PATH=

# -----------------------------------------------------------------------------
# Base de datos (Obligatorio)
# -----------------------------------------------------------------------------

# URL de conexión a la base de datos
# Por defecto usa SQLite local. Reservado para migrar a Postgres.
# Ejemplo SQLite: sqlite:///storage/omnivoice.db
# Ejemplo Postgres: postgresql+asyncpg://user:pass@localhost:5432/omnivoice
DATABASE_URL=sqlite:///storage/omnivoice.db


# ============================================================================
# VARIABLES OPCIONALES
# (Tienen valores por defecto; puedes omitirlas o sobreescribirlas)
# ============================================================================

# --- App ---
APP_NAME=OmniVoice API                            # Valor por defecto: "OmniVoice API"
APP_VERSION=0.1.0                                # Valor por defecto: "0.1.0"
DEBUG=false                                      # Valor por defecto: false
API_PREFIX=/api/v1                               # Valor por defecto: "/api/v1"

# --- OmniVoice Engine ---
# Módulo CLI ejecutable dentro del venv externo
OMNIVOICE_CLI_ENTRY=omnivoice_cli.__main__       # Valor por defecto: "omnivoice_cli.__main__"
# Dispositivo de inferencia (cuda:0, cpu, etc.)
OMNIVOICE_DEVICE=cuda:0                         # Valor por defecto: "cuda:0"
# Lista de códigos de idioma ISO 639-1 soportados (separados por coma)
OMNIVOICE_LANGUAGES=es,en,zh,ja,ko,fr,de       # Valor por defecto: "es,en,zh,ja,ko,fr,de"
# Duración máxima permitida para audio de referencia en segundos
MAX_REFERENCE_DURATION_SEC=30                    # Valor por defecto: 30
# Número máximo de síntesis simultáneas (P2000 = 1)
ENGINE_CONCURRENCY=1                             # Valor por defecto: 1
# Timeout para el arranque del subprocess del engine en segundos
ENGINE_STARTUP_TIMEOUT_SEC=30                    # Valor por defecto: 30
# Timeout por petición al engine en segundos
ENGINE_REQUEST_TIMEOUT_SEC=120                   # Valor por defecto: 120

# --- Mock / Real engine toggle ---
# Si True, usa generación de tonos mock (útil para tests sin GPU/modelo).
# Si False (por defecto), usa la API Python de OmniVoice directamente
# (`from omnivoice import OmniVoice`).
OMNIVOICE_USE_MOCK=false                         # Valor por defecto: false
# Si True, cuando el motor real falle al arrancar, la API cae automáticamente
# al modo mock en lugar de crashear. El endpoint /api/v1/health devolverá
# status="degraded" y el campo real_engine_error con la causa raíz.
OMNIVOICE_FALLBACK_TO_MOCK=true                  # Valor por defecto: true

# --- Storage ---
STORAGE_BASE_PATH=storage                        # Valor por defecto: "storage"
VOICES_DIR=storage/voices                       # Valor por defecto: "storage/voices"
OUTPUTS_DIR=storage/outputs                      # Valor por defecto: "storage/outputs"
CACHE_DIR=storage/cache                         # Valor por defecto: "storage/cache"
# TTL para archivos de output temporales en segundos
OUTPUT_TTL_SECONDS=3600                          # Valor por defecto: 3600

# --- Security ---
# API Key opcional para proteger endpoints (vacío = desactivado)
API_KEY=                                         # Valor por defecto: "" (desactivado)
# Orígenes permitidos para CORS ("*" = todos, separados por coma)
CORS_ORIGINS=*                                   # Valor por defecto: "*"
# Tamaño máximo de upload en MB
MAX_UPLOAD_SIZE_MB=10                            # Valor por defecto: 10

# --- Observabilidad ---
# Nivel de logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO                                   # Valor por defecto: "INFO"
# Formato de logs: json o console
LOG_FORMAT=json                                  # Valor por defecto: "json"
