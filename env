# =============================================================================
# OmniVoice API — Variables de entorno
# =============================================================================
# Copia este archivo a `.env` y ajusta los valores según tu entorno.
# Los tipos y valores por defecto están definidos en `omnivoice_api/settings.py`.
# =============================================================================


# -----------------------------------------------------------------------------
# Bloque 1 — Variables OBLIGATORIAS (sin valor por defecto útil en producción)
# -----------------------------------------------------------------------------

# Ruta al directorio de la instalación externa de OmniVoice (Path, str)
# Ejemplo Windows: C:/tools/omnivoice
# Ejemplo Linux:   /opt/omnivoice
OMNIVOICE_INSTALL_DIR=C:/AI/TTS/OMNIVOICE/OMNIVOICE
OMNIVOICE_PATH=C:/AI/TTS/OMNIVOICE/OMNIVOICE

# Ruta al venv externo que contiene OmniVoice + CUDA (Path, str)
# Ejemplo Windows: C:/tools/omnivoice/.venv
# Ejemplo Linux:   /opt/omnivoice/.venv
OMNIVOICE_VENV_DIR=C:/AI/TTS/OMNIVOICE/OMNIVOICE_ENV

# Ruta al modelo de OmniVoice (Path, str)
# Si se deja vacío, se deriva como: ${OMNIVOICE_INSTALL_DIR}/models
OMNIVOICE_MODEL_PATH=

# URL de conexión a la base de datos (str)
# Por defecto usa SQLite local. Reservado para migrar a Postgres.
# Ejemplo Postgres: postgresql+asyncpg://user:pass@localhost:5432/omnivoice
DATABASE_URL=sqlite:///storage/omnivoice.db


# -----------------------------------------------------------------------------
# Bloque 2 — Variables OPCIONALES (con valor por defecto razonable)
# -----------------------------------------------------------------------------

# --- App ---
APP_NAME=OmniVoice API
APP_VERSION=0.1.0
DEBUG=false
API_PREFIX=/api/v1

# --- OmniVoice Engine ---
# Módulo CLI ejecutable dentro del venv externo (str)
OMNIVOICE_CLI_ENTRY=omnivoice_cli.__main__
# Dispositivo de inferencia (str)
OMNIVOICE_DEVICE=cuda:0
# Lista de códigos de idioma ISO 639-1 soportados (list[str], separados por coma)
OMNIVOICE_LANGUAGES=es,en,zh,ja,ko,fr,de
# Duración máxima permitida para audio de referencia en segundos (int)
MAX_REFERENCE_DURATION_SEC=30
# Número máximo de síntesis simultáneas (int). P2000 = 1
ENGINE_CONCURRENCY=1
# Timeout para el arranque del subprocess del engine en segundos (int)
ENGINE_STARTUP_TIMEOUT_SEC=30
# Timeout por petición al engine en segundos (int)
ENGINE_REQUEST_TIMEOUT_SEC=120

# --- Storage ---
STORAGE_BASE_PATH=storage
VOICES_DIR=storage/voices
OUTPUTS_DIR=storage/outputs
CACHE_DIR=storage/cache
# TTL para archivos de output temporales en segundos (int)
OUTPUT_TTL_SECONDS=3600

# --- Security ---
# API Key opcional para proteger endpoints (str). Vacío = desactivado
API_KEY=
# Orígenes permitidos para CORS (list[str], separados por coma). "*" = todos
CORS_ORIGINS=*
# Tamaño máximo de upload en MB (int)
MAX_UPLOAD_SIZE_MB=10

# --- Observability ---
# Nivel de logging: DEBUG, INFO, WARNING, ERROR (str)
LOG_LEVEL=INFO
# Formato de logs: json o console (str)
LOG_FORMAT=json
